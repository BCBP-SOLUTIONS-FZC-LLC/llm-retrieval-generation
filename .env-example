# Copy to .env (`make setup` does it). Names are the upper-cased Settings fields
# (src/rag/infrastructure/config.py). Matches docker-compose.yml's host ports.
APP_ENV=dev
APP_PORT=8080

# Application DSNs: through PgBouncer, as the non-superuser rag_app_login (RLS enforced).
CORPUS_DATABASE_URL=postgresql://rag_app_login:devpassword@localhost:5536/llm_corpus
GENERATION_DATABASE_URL=postgresql://rag_app_login:devpassword@localhost:5536/llm_generation
PG_BOUNCER_MODE=true
PG_MAX_CONNS=10
# Optional pool tuning, parsed and validated by pgcommon itself (read from the process environment;
# `make run` exports this file). A bad value becomes the library's default plus a startup warning.
# PG_STATEMENT_TIMEOUT=30s
# PG_LOCK_TIMEOUT=5s
# PG_ACQUIRE_TIMEOUT=10s
# PG_SLOW_QUERY_THRESHOLD=200ms
# PG_MAX_CONN_LIFETIME=1h
# PG_MAX_CONN_IDLE_TIME=30m
# PG_HEALTH_CHECK_PERIOD=1m
# PG_MIN_CONNS=0

# Migration DSNs: direct to Postgres as the superuser (session-scoped advisory lock, DDL).
CORPUS_MIGRATION_DATABASE_URL=postgresql://rag_admin:devpassword@localhost:5535/llm_corpus
GENERATION_MIGRATION_DATABASE_URL=postgresql://rag_admin:devpassword@localhost:5535/llm_generation

VALKEY_URL=redis://localhost:6381/0
QDRANT_URL=http://localhost:6335

# floci (S3 / SNS / SQS emulator)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4568
S3_BUCKET=rag-artefacts
S3_REGION=eu-west-1
S3_ENDPOINT_URL=http://localhost:4568

# Events are off by default; set EVENTS_ENABLED=true and the topic / queue URLs to run the relays.
EVENTS_ENABLED=false
GENERATION_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:llm-generation-events
INDEX_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:llm-index-events

# The model gateway: unset keeps the default (not reachable locally). `make gateway-up` starts one.
# GATEWAY_BASE_URL=http://localhost:1975
# The gateway's wire details are configuration, so a different gateway needs no code change.
# Defaults are Agent Router's (rerank is Cohere's v2 API there); uncomment only to change them.
# GATEWAY_CHAT_PATH=/v1/chat/completions
# GATEWAY_EMBEDDINGS_PATH=/v1/embeddings
# GATEWAY_RERANK_PATH=/cohere/v2/rerank
# GATEWAY_TOKENIZE_PATH=/tokenize
# GATEWAY_MODELS_PATH=/v1/models
# GATEWAY_TENANT_HEADER=x-tenant-id
# GATEWAY_RESIDENCY_HEADER=x-residency-mode
# GATEWAY_PLAN_HEADER=x-plan
# GATEWAY_PREFERRED_MODEL_HEADER=x-preferred-model

# Unset: no workflow engine, async routes answer 503 WORKFLOW_ENGINE_UNAVAILABLE.
TEMPORAL_ADDRESS=
