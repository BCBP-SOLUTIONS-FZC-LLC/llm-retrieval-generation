{
  "$defs": {
    "ArtefactKind": {
      "description": "Kind of generated artefact.",
      "enum": [
        "answer",
        "section_draft",
        "document",
        "extraction"
      ],
      "title": "ArtefactKind",
      "type": "string"
    },
    "ArtefactOrigin": {
      "description": "How an artefact version came to exist.",
      "enum": [
        "original",
        "regeneration",
        "coherence_repair"
      ],
      "title": "ArtefactOrigin",
      "type": "string"
    },
    "CoherenceVerdict": {
      "description": "Document coherence verdict.",
      "enum": [
        "not_computed",
        "consistent",
        "conflicted"
      ],
      "title": "CoherenceVerdict",
      "type": "string"
    },
    "CompletenessVerdict": {
      "description": "Completeness verdict (\u00a78.2).",
      "enum": [
        "complete",
        "partial",
        "insufficient",
        "not_computed"
      ],
      "title": "CompletenessVerdict",
      "type": "string"
    },
    "DeliveryState": {
      "description": "Whether generated text reached the client.",
      "enum": [
        "delivered",
        "disconnected",
        "not_applicable"
      ],
      "title": "DeliveryState",
      "type": "string"
    },
    "EvidenceTier": {
      "description": "Evidence tier; ``NOT_COMPUTED`` sorts lowest so the roll-up is ``min()`` (MD-24, LD-56).",
      "enum": [
        "NOT_COMPUTED",
        "INSUFFICIENT",
        "PARTIAL",
        "SUPPORTED"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "Recipient": {
      "additionalProperties": true,
      "description": "``{kind, id}`` echoed from the request that started the run (LD-83).\n\n``kind`` is ``user`` or ``department``; the request refuses any other.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Recipient",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "A version was written; short-form included (GEN-10). No approval state (AOB-1, EVT-11).",
  "properties": {
    "artefact_id": {
      "title": "Artefact Id",
      "type": "string"
    },
    "artefact_version_id": {
      "title": "Artefact Version Id",
      "type": "string"
    },
    "coherence_verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoherenceVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completeness": {
      "$ref": "#/$defs/CompletenessVerdict"
    },
    "delivery": {
      "$ref": "#/$defs/DeliveryState"
    },
    "evidence_tier": {
      "$ref": "#/$defs/EvidenceTier"
    },
    "generation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Id"
    },
    "kind": {
      "$ref": "#/$defs/ArtefactKind"
    },
    "minted_reason": {
      "title": "Minted Reason",
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/ArtefactOrigin"
    },
    "principal_id": {
      "title": "Principal Id",
      "type": "string"
    },
    "recipients": {
      "items": {
        "$ref": "#/$defs/Recipient"
      },
      "title": "Recipients",
      "type": "array"
    },
    "section_count": {
      "title": "Section Count",
      "type": "integer"
    },
    "tender_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tender Id"
    },
    "version_no": {
      "title": "Version No",
      "type": "integer"
    }
  },
  "required": [
    "artefact_id",
    "artefact_version_id",
    "version_no",
    "principal_id",
    "kind",
    "minted_reason",
    "origin",
    "evidence_tier",
    "completeness",
    "delivery",
    "section_count"
  ],
  "title": "GenerationCompleted",
  "type": "object"
}
